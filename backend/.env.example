# CORS – adresy frontendu (backend zwraca nagłówek Access-Control-Allow-Origin tylko dla nich).
# Jedna wartość:
# FRONTEND_URL="http://localhost:5173"
# Wiele (po przecinku) – zalecane na VPS (tylko IP):
# FRONTEND_URLS="http://91.99.237.141,http://localhost:5173,https://twoja-domena.pl"
# Dla produkcji (tylko IP): https://<VPS_IP>, http://<VPS_IP>.
FRONTEND_URL="http://localhost:5173"
# FRONTEND_URLS="http://91.99.237.141"

PORT=3001
NODE_ENV=development

# SMTP — konfiguracja wysyłania emaili
# SMTP_HOST=smtp.twojadomena.pl
# SMTP_PORT=587
# SMTP_SECURE=false          # true dla portu 465 (SSL), false dla 587 (STARTTLS)
# SMTP_USER=twoj@email.pl
# SMTP_PASS=twoje-haslo
# EMAIL_FROM="Klinika Trichologii <twoj@email.pl>"
# SMTP_TLS_REJECT_UNAUTHORIZED=true   # false tylko na dev z self-signed cert

# IMAP — zapis kopii do folderu Wysłane (widoczne w Gmail, Outlook, Thunderbird itp.)
# Jeśli host/user/pass są takie same jak SMTP, poniższe zmienne można pominąć.
# IMAP_HOST=imap.twojadomena.pl   # domyślnie: wartość SMTP_HOST
# IMAP_PORT=993                   # 993 = SSL/TLS (zalecane), 143 = STARTTLS
# IMAP_SECURE=true                # false przełącza na STARTTLS (port 143)
# IMAP_USER=twoj@email.pl         # domyślnie: wartość SMTP_USER
# IMAP_PASS=twoje-haslo           # domyślnie: wartość SMTP_PASS
# IMAP_SENT_FOLDER=Sent           # zostaw puste — folder wykrywany automatycznie
# IMAP_SAVE_SENT=true             # false wyłącza całą funkcję

# Opcjonalne
# UPLOAD_DIR=./storage/uploads
# FRONTEND_URL – używane, gdy nie ma FRONTEND_URLS
